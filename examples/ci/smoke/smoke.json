{
  "meta": {
    "tags": [
      "example",
      "smoke"
    ],
    "setup": [
      [
        "WR_set_driver",
        {
          "webdriver_name": "chrome",
          "options": [
            "--headless=new",
            "--disable-gpu"
          ]
        }
      ]
    ],
    "teardown": [
      [
        "WR_quit_all"
      ]
    ],
    "fail_fast": true
  },
  "webdriver_wrapper": [
    [
      "WR_to_url",
      {
        "url": "data:text/html,<title>WebRunner smoke</title><h1 id='hello'>It runs</h1>"
      }
    ],
    [
      "WR_assert_title",
      {
        "value": "WebRunner smoke"
      }
    ],
    [
      "WR_find_element_by",
      {
        "selector": "#hello"
      }
    ],
    [
      "WR_element_assert",
      {
        "check_dict": {
          "text": "It runs"
        }
      }
    ]
  ]
}
