{
  "meta": {
    "tags": ["example", "flow"],
    "vars": {
      "base": "${ENV.WR_DEMO_BASE}",
      "pages": [
        {"path": "index.html", "title": "Local agent demo"},
        {"path": "search.html", "title": "Local search"},
        {"path": "details.html", "title": "Local result"}
      ],
      "names": ["Ada", "Grace"]
    },
    "setup": [
      ["WR_set_driver", {"webdriver_name": "chrome", "options": ["--headless=new", "--disable-gpu"]}]
    ],
    "teardown": [
      ["WR_quit_all"]
    ],
    "fail_fast": true
  },
  "webdriver_wrapper": [
    ["WR_for_each", {"items": "${pages}", "var": "page", "do": [
      ["WR_call_file", {"path": "steps/check_page.json", "params": {"path": "${page.path}", "title": "${page.title}"}}]
    ]}],
    ["WR_to_url", {"url": "${base}/index.html"}],
    ["WR_for_each", {"items": "${names}", "var": "name", "index_var": "round", "do": [
      ["WR_call_file", {"path": "steps/greet.json", "params": {"name": "${name}"}}],
      ["WR_assert_var", {"var": "greeting", "op": "eq", "value": "Hello ${name}"}]
    ]}],
    ["WR_if", {
      "condition": {"succeeds": ["WR_find_element_by", {"selector": "#no-such-element"}]},
      "then": [["WR_fail", {"message": "an element that is not on the page was found"}]],
      "otherwise": [["WR_note", {"text": "no #no-such-element on ${base}/index.html, as expected"}]]
    }],
    ["WR_try", {
      "do": [["WR_assert_title", {"value": "A title this page does not have"}]],
      "on_error": [["WR_set_var", {"name": "caught", "value": "${error}"}]]
    }],
    ["WR_assert_var", {"var": "caught", "op": "contains", "value": "Local agent demo"}]
  ]
}
